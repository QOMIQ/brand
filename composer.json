{
    "name": "qomiq/brand",
    "description": "QOMIQ: značka (loga, barvy, písmo) a Filament téma pro adminy projektů",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Qomiq\\Brand\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qomiq\\Brand\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Qomiq\\Brand\\BrandServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^11",
        "pestphp/pest": "^5",
        "larastan/larastan": "^3",
        "laravel/pint": "^1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    }
}
